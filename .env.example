# Local/test profile. Production validation deliberately rejects SQLite and disabled auth.
ASSURANCEOS_ENV=local
ASSURANCEOS_DATABASE_PATH=./var/assuranceos.db
# ASSURANCEOS_DATABASE_URL=postgresql+psycopg://assuranceos:password@localhost:5432/assuranceos
ASSURANCEOS_AUTO_CREATE_SCHEMA=false

ASSURANCEOS_AGENT_ROOT=./agents
ASSURANCEOS_DEMO_ROOT=./demo/asteria
ASSURANCEOS_CONTROL_TEST_ROOT=./tests-library
ASSURANCEOS_CONTROL_TEST_PUBLIC_KEY=./security/release-keys/control-test-release-public.pem
ASSURANCEOS_MODEL_MODE=mock
ASSURANCEOS_GEMINI_MODEL=gemini-2.5-flash

ASSURANCEOS_EVIDENCE_STORAGE=local
ASSURANCEOS_EVIDENCE_ROOT=./var/evidence
ASSURANCEOS_EVIDENCE_EXPORT_ROOT=./var/evidence-exports
ASSURANCEOS_EVIDENCE_BUCKET=
ASSURANCEOS_MAX_EVIDENCE_UPLOAD_BYTES=52428800

# Local developer convenience only. Set jwt in deployed environments.
ASSURANCEOS_AUTH_MODE=disabled
ASSURANCEOS_AUTH_JWT_ISSUER=
ASSURANCEOS_AUTH_JWT_AUDIENCE=
ASSURANCEOS_AUTH_JWT_SECRET=
ASSURANCEOS_AUTH_JWKS_URL=
ASSURANCEOS_AUTH_JWT_ALGORITHMS=RS256
ASSURANCEOS_AUTH_CLOCK_LEEWAY_SECONDS=30
ASSURANCEOS_TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Optional locally; required by the production API.
ASSURANCEOS_EXPORT_SIGNING_PRIVATE_KEY=
ASSURANCEOS_EXPORT_SIGNING_PUBLIC_KEY=
ASSURANCEOS_EXPORT_SIGNING_KEY_ID=local-ed25519-v1

# Required for agent task issuance in deployed environments. The private key belongs
# to the control plane; only security/release-keys/execution-envelope-public.pem is committed.
ASSURANCEOS_EXECUTION_SIGNING_PRIVATE_KEY=
ASSURANCEOS_EXECUTION_ENVELOPE_PUBLIC_KEY=./security/release-keys/execution-envelope-public.pem
ASSURANCEOS_EXECUTION_SIGNING_KEY_ID=assuranceos-execution-v1
ASSURANCEOS_EXECUTION_ENVELOPE_TTL_SECONDS=900

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STAGING_BUCKET=
