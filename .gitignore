.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.env
# Real credentials live here, never in .env, which is committed as a template.
.env.local
.env.*.local
*.db
*.sqlite3
build/
dist/
*.egg-info/
.terraform/
terraform.tfstate*
# A saved plan embeds the resolved value of every variable, and a .tfvars file is
# where deployment inputs collect. Neither belongs in a public repository, even
# when today's copy happens to carry only secret identifiers and public URLs.
*.tfplan
tfplan*
*.tfvars
*.tfvars.tmp
.DS_Store
# The Agent Engine deploy stages its runtime wheel flat at the repository root,
# because that is the one placement the uploader recreates where pip can find it.
/assuranceos-*.whl
coverage.xml
htmlcov/
.coverage
.coverage.*

var/
