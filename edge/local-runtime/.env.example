# Pin the serving image by digest for a reproducible runtime.
ASSURANCEOS_LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp@sha256:<approved-image-digest>
ASSURANCEOS_MODEL_DIR=/absolute/path/to/models
ASSURANCEOS_MODEL_FILE=approved-model.gguf
ASSURANCEOS_LOCAL_MODEL_NAME=approved-local-model
ASSURANCEOS_MODEL_CONTEXT_SIZE=16384

# Generate these values outside the repository and keep the .env file private.
ASSURANCEOS_DATABASE_PASSWORD=<random-database-password>
ASSURANCEOS_AUTH_JWT_SECRET=<random-secret-at-least-32-bytes>
ASSURANCEOS_EXPORT_SIGNING_PRIVATE_KEY_HOST=/absolute/path/to/export-private.pem
ASSURANCEOS_EXECUTION_SIGNING_PRIVATE_KEY_HOST=/absolute/path/to/execution-private.pem
ASSURANCEOS_EXPORT_SIGNING_KEY_ID=local-privacy-export-v1
